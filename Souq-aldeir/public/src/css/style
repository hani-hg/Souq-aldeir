/* ============================================================
   SOUQ ALDEIR - MAIN STYLESHEET
   يُستخدم في كل صفحات الموقع
============================================================ */

:root {
  --blue: #1565c0; --blue2: #1976d2; --blue-light: #e3f2fd;
  --orange: #f57c00; --green: #2e7d32; --green-light: #e8f5e9;
  --red: #c62828; --red-light: #ffebee; --gold: #f9a825; --gold-light: #fffde7;
  --bg: #f2f4f8; --white: #fff; --border: #e0e4ef; --gray: #6b7280; --dark: #1a1f36;
  --radius: 14px; --shadow: 0 2px 14px rgba(21,101,192,.10);
}
* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Tajawal', sans-serif; }
body { background: var(--bg); color: var(--dark); padding-bottom: 72px; }

/* ===== NAV ===== */
.topnav { position: sticky; top: 0; z-index: 200; background: var(--blue); padding: 10px 14px; display: flex; align-items: center; gap: 10px; }
.logo-wrap { display: flex; align-items: center; gap: 8px; flex: 1; }
.logo-icon { width: 36px; height: 36px; background: var(--gold); border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.2em; }
.logo-text { color: #fff; font-size: 1.1em; font-weight: 800; line-height: 1.1; }
.logo-text small { font-size: .65em; opacity: .75; font-weight: 400; display: block; }
.nav-btns { display: flex; gap: 8px; }
.nav-btn { background: rgba(255,255,255,.15); border: none; color: #fff; width: 36px; height: 36px; border-radius: 50%; font-size: .95em; cursor: pointer; display: flex; align-items: center; justify-content: center; position: relative; transition: background .2s; }
.nav-btn:hover { background: rgba(255,255,255,.25); }
.nbadge { position: absolute; top: -3px; right: -3px; background: var(--red); color: #fff; width: 16px; height: 16px; border-radius: 50%; font-size: .58em; display: none; align-items: center; justify-content: center; }

/* ===== NEWS TICKER ===== */
.news-bar { background: #b71c1c; color: #fff; padding: 5px 0; overflow: hidden; display: flex; align-items: center; }
.news-label { background: rgba(0,0,0,.3); padding: 5px 12px; font-size: .78em; font-weight: 800; white-space: nowrap; flex-shrink: 0; display: flex; align-items: center; gap: 5px; }
.news-track { overflow: hidden; flex: 1; }
.news-inner { display: inline-block; white-space: nowrap; animation: marquee 30s linear infinite; }
.news-inner:hover { animation-play-state: paused; }
@keyframes marquee { from { transform: translateX(-100%); } to { transform: translateX(100vw); } }
.news-inner span { font-size: .78em; padding: 0 24px; }

/* ===== SEARCH ===== */
.searchbar { background: var(--blue2); padding: 8px 14px 12px; }
.search-wrap { display: flex; gap: 8px; background: #fff; border-radius: 50px; padding: 7px 14px; align-items: center; }
.search-wrap input { flex: 1; border: none; outline: none; font-size: .95em; font-family: 'Tajawal', sans-serif; color: var(--dark); }

/* ===== CATEGORIES ===== */
.cats-scroll { background: var(--white); border-bottom: 1px solid var(--border); padding: 10px 14px; overflow-x: auto; white-space: nowrap; display: flex; gap: 8px; scrollbar-width: none; }
.cats-scroll::-webkit-scrollbar { display: none; }
.cat-chip { display: inline-flex; flex-direction: column; align-items: center; background: var(--bg); border: 1.5px solid var(--border); border-radius: 12px; padding: 8px 13px; cursor: pointer; min-width: 68px; gap: 4px; transition: all .2s; }
.cat-chip.active, .cat-chip:hover { background: var(--blue); border-color: var(--blue); color: #fff; }
.cat-chip i { font-size: 1.25em; color: var(--blue); }
.cat-chip.active i, .cat-chip:hover i { color: #fff; }
.cat-chip span { font-size: .72em; font-weight: 700; }

/* ===== FILTER BAR ===== */
.filter-bar { display: flex; align-items: center; justify-content: space-between; padding: 9px 14px; background: var(--white); border-bottom: 1px solid var(--border); }
.ads-count { font-size: .85em; color: var(--gray); }
.sort-select { border: 1.5px solid var(--border); background: #fff; border-radius: 20px; padding: 5px 10px; font-size: .8em; font-family: 'Tajawal', sans-serif; color: var(--dark); cursor: pointer; outline: none; }

/* ===== SLIDER (featured ads) ===== */
.slider-section { margin: 12px 12px 0; border-radius: var(--radius); overflow: hidden; position: relative; background: linear-gradient(135deg,#1565c0,#283593); min-height: 120px; }
.slider-track { display: flex; transition: transform .5s ease; }
.slide { min-width: 100%; padding: 16px 18px; display: flex; align-items: center; gap: 14px; cursor: pointer; }
.slide-img { width: 85px; height: 85px; object-fit: cover; border-radius: 12px; flex-shrink: 0; background: rgba(255,255,255,.1); }
.slide-noimg { width: 85px; height: 85px; border-radius: 12px; flex-shrink: 0; background: rgba(255,255,255,.15); display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,.5); font-size: 2.2em; }
.slide-info { flex: 1; color: #fff; }
.slide-badge { background: var(--gold); color: #7a5000; font-size: .65em; font-weight: 800; padding: 2px 8px; border-radius: 20px; display: inline-block; margin-bottom: 6px; }
.slide-title { font-size: 1em; font-weight: 800; margin-bottom: 4px; }
.slide-price { font-size: .88em; color: #ffd54f; font-weight: 700; }
.slide-loc { font-size: .73em; opacity: .75; margin-top: 3px; }
.slider-dots { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); display: flex; gap: 5px; }
.sdot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,.35); cursor: pointer; transition: background .2s; }
.sdot.on { background: #fff; }
.slider-arrows { position: absolute; top: 50%; transform: translateY(-50%); width: 100%; display: flex; justify-content: space-between; padding: 0 8px; pointer-events: none; }
.sarrow { pointer-events: all; background: rgba(255,255,255,.2); border: none; color: #fff; width: 28px; height: 28px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: .8em; }

/* ===== PROMO BUTTON ===== */
.promo-btn { margin: 10px 12px 0; background: linear-gradient(135deg,var(--gold),var(--orange)); border-radius: var(--radius); padding: 13px 16px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; border: none; width: calc(100% - 24px); }
.promo-btn .ptxt h4 { color: #fff; font-size: .95em; font-weight: 800; text-align: right; }
.promo-btn .ptxt p { color: rgba(255,255,255,.88); font-size: .75em; margin-top: 2px; text-align: right; }

/* ===== ADS GRID ===== */
.ads-wrap { padding: 10px 12px 0; }
.ads-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
@media (min-width:500px) { .ads-grid { grid-template-columns: repeat(3,1fr); } }
@media (min-width:750px) { .ads-grid { grid-template-columns: repeat(4,1fr); } }
.ad-card { background: var(--white); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); cursor: pointer; transition: transform .18s; position: relative; }
.ad-card:active { transform: scale(.97); }
.ad-card.featured { border: 2px solid var(--gold); }
.feat-badge { position: absolute; top: 0; left: 0; background: var(--gold); color: #7a5000; font-size: .62em; font-weight: 800; padding: 3px 8px; border-radius: 0 0 8px 0; z-index: 2; }
.ad-img { width: 100%; height: 140px; object-fit: cover; background: linear-gradient(135deg,#dde4f5,#c5d0ea); display: block; }
.ad-noimg { width: 100%; height: 140px; background: linear-gradient(135deg,#dde4f5,#c5d0ea); display: flex; align-items: center; justify-content: center; color: #aab; font-size: 2em; }
.ad-fav { position: absolute; top: 7px; right: 7px; background: rgba(255,255,255,.92); border: none; width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .82em; cursor: pointer; color: #ccc; z-index: 2; }
.ad-fav.liked { color: var(--red); }
.ad-catbadge { position: absolute; bottom: 6px; left: 6px; background: rgba(21,101,192,.82); color: #fff; font-size: .6em; font-weight: 700; padding: 2px 7px; border-radius: 20px; z-index: 2; }
.ad-body { padding: 8px 10px 10px; }
.ad-price { font-size: 1em; font-weight: 800; color: var(--green); }
.ad-title { font-size: .82em; color: var(--dark); font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 3px 0 2px; }
.ad-loc { font-size: .7em; color: var(--gray); display: flex; align-items: center; gap: 3px; }
.ad-time { font-size: .63em; color: #bbc; margin-top: 3px; }

.empty-state, .loading-state { grid-column: 1/-1; text-align: center; padding: 50px 20px; color: var(--gray); }
.empty-state i, .loading-state i { font-size: 2.8em; display: block; margin-bottom: 10px; opacity: .35; }
.loading-state i { color: var(--blue); opacity: 1; }

/* ===== FAB ===== */
.fab { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%); z-index: 150; background: var(--orange); color: #fff; border: none; border-radius: 50px; padding: 12px 26px; font-size: .95em; font-weight: 700; font-family: 'Tajawal', sans-serif; box-shadow: 0 4px 20px rgba(245,124,0,.4); cursor: pointer; display: flex; align-items: center; gap: 7px; }
.fab:active { transform: translateX(-50%) scale(.95); }

/* ===== BOTTOM NAV ===== */
.bnav { position: fixed; bottom: 0; left: 0; right: 0; z-index: 200; background: var(--white); border-top: 1px solid var(--border); display: flex; justify-content: space-around; align-items: center; padding: 7px 0 10px; }
.bnav-btn { display: flex; flex-direction: column; align-items: center; gap: 2px; font-size: .64em; color: var(--gray); cursor: pointer; border: none; background: none; font-family: 'Tajawal', sans-serif; padding: 0 8px; }
.bnav-btn i { font-size: 1.35em; }
.bnav-btn.on { color: var(--blue); }

/* ===== MODALS ===== */
.modal { display: none; position: fixed; inset: 0; background: rgba(10,20,50,.52); z-index: 999; justify-content: center; align-items: flex-end; backdrop-filter: blur(3px); }
.modal.show { display: flex; }
.sheet { background: var(--white); border-radius: 20px 20px 0 0; width: 100%; max-height: 92vh; overflow-y: auto; padding: 14px 18px 32px; animation: slideup .25s ease; }
@keyframes slideup { from { transform: translateY(60px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.handle { width: 38px; height: 4px; background: #ddd; border-radius: 4px; margin: 0 auto 14px; }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
.sheet-title { font-size: 1.1em; font-weight: 800; color: var(--dark); }
.xbtn { background: var(--bg); border: none; width: 30px; height: 30px; border-radius: 50%; font-size: 1em; color: var(--gray); cursor: pointer; display: flex; align-items: center; justify-content: center; }

/* ===== FORMS ===== */
.fg { margin-bottom: 12px; }
.fg label { display: block; font-size: .82em; font-weight: 700; color: var(--gray); margin-bottom: 4px; }
.fg input, .fg textarea, .fg select { width: 100%; padding: 10px 12px; border: 1.5px solid var(--border); border-radius: 10px; font-size: .92em; font-family: 'Tajawal', sans-serif; color: var(--dark); outline: none; background: var(--bg); transition: border .2s; }
.fg input:focus, .fg textarea:focus, .fg select:focus { border-color: var(--blue); background: #fff; }
.fg textarea { resize: vertical; min-height: 72px; }
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.btn { width: 100%; padding: 12px; border: none; border-radius: 50px; font-size: .95em; font-weight: 700; font-family: 'Tajawal', sans-serif; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 7px; margin-top: 4px; transition: opacity .2s; }
.btn:disabled { opacity: .6; cursor: not-allowed; }
.btn-blue { background: var(--blue); color: #fff; }
.btn-orange { background: var(--orange); color: #fff; }
.btn-green { background: var(--green); color: #fff; }
.btn-outline { background: #fff; border: 1.5px solid var(--blue); color: var(--blue); }
.btn-red { background: var(--red); color: #fff; }
.btn-gold { background: var(--gold); color: #7a5000; }
.btn-gray { background: #eee; border: 1.5px solid var(--border); color: var(--gray); }
.btn-sm { padding: 7px 16px; width: auto; border-radius: 20px; font-size: .82em; margin-top: 0; }
.errmsg, .sucmsg { font-size: .82em; padding: 8px 12px; border-radius: 8px; margin-bottom: 10px; display: none; }
.errmsg { color: var(--red); background: var(--red-light); }
.sucmsg { color: var(--green); background: var(--green-light); }
.errmsg.show, .sucmsg.show { display: block; }

/* ===== TABS ===== */
.tab-bar { display: flex; background: var(--bg); border-radius: 10px; padding: 3px; gap: 3px; margin-bottom: 14px; }
.tab-btn { flex: 1; text-align: center; padding: 7px 4px; border-radius: 8px; font-size: .8em; font-weight: 700; cursor: pointer; color: var(--gray); border: none; background: none; font-family: 'Tajawal', sans-serif; transition: all .2s; }
.tab-btn.on { background: var(--white); color: var(--blue); box-shadow: 0 1px 6px rgba(0,0,0,.1); }

/* ===== AD DETAIL ===== */
.det-img { width: 100%; max-height: 220px; object-fit: cover; border-radius: 14px; margin-bottom: 12px; }
.det-price { font-size: 1.5em; font-weight: 800; color: var(--green); margin: 8px 0; }
.det-desc { color: var(--gray); line-height: 1.75; margin-bottom: 12px; font-size: .92em; }
.infobox { background: var(--bg); border-radius: 12px; padding: 10px 14px; margin-bottom: 10px; }
.inforow { display: flex; align-items: center; gap: 9px; padding: 6px 0; font-size: .88em; border-bottom: 1px solid var(--border); }
.inforow:last-child { border-bottom: none; }
.inforow i { color: var(--blue); width: 18px; text-align: center; }
.callbtn { display: flex; align-items: center; justify-content: center; gap: 8px; background: var(--green-light); color: var(--green); border: 1.5px solid #a5d6a7; border-radius: 12px; padding: 12px; font-weight: 700; font-size: 1em; text-decoration: none; margin-top: 6px; }
.wabtn { display: flex; align-items: center; justify-content: center; gap: 8px; background: #e8f5e9; color: #1b5e20; border: 1.5px solid #81c784; border-radius: 12px; padding: 12px; font-weight: 700; font-size: 1em; text-decoration: none; margin-top: 6px; }
.actbtns { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }

/* ===== DASHBOARD ===== */
.dcard { background: var(--white); border-radius: var(--radius); padding: 14px; box-shadow: var(--shadow); margin-bottom: 12px; }
.dstat { font-size: 1.8em; font-weight: 800; color: var(--blue); }
.myadrow { display: flex; gap: 10px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--border); }
.myadrow:last-child { border-bottom: none; }
.myadimg { width: 54px; height: 54px; border-radius: 10px; background: var(--bg); flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: #aab; font-size: 1.3em; overflow: hidden; }
.myadimg img { width: 100%; height: 100%; object-fit: cover; }
.myadinfo { flex: 1; min-width: 0; }
.myadtitle { font-size: .87em; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.myadprice { font-size: .8em; color: var(--green); font-weight: 700; }
.myadstatus { font-size: .68em; color: var(--gray); }
.myadbtns { display: flex; gap: 5px; flex-shrink: 0; }
.icobtn { width: 30px; height: 30px; border-radius: 8px; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: .82em; }
.icobtn.ed { background: var(--blue-light); color: var(--blue); }
.icobtn.dl { background: var(--red-light); color: var(--red); }

/* ===== ADMIN ===== */
.admin-req { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border); }
.admin-req:last-child { border-bottom: none; }

/* ===== CHAT ===== */
.chatrow { display: flex; align-items: center; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--border); cursor: pointer; }
.chatrow:last-child { border-bottom: none; }
.chatav { width: 42px; height: 42px; border-radius: 50%; background: var(--blue); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1em; flex-shrink: 0; }
.chatinfo { flex: 1; min-width: 0; }
.chatname { font-size: .9em; font-weight: 700; }
.chatmsg { font-size: .77em; color: var(--gray); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chatwin { display: flex; flex-direction: column; height: 58vh; }
.chatmsgs { flex: 1; overflow-y: auto; padding: 10px 0; display: flex; flex-direction: column; gap: 8px; }
.mbubble { max-width: 75%; padding: 9px 12px; border-radius: 14px; font-size: .88em; line-height: 1.5; word-break: break-word; }
.mbubble.mine { background: var(--blue); color: #fff; align-self: flex-start; border-radius: 14px 14px 14px 4px; }
.mbubble.theirs { background: var(--bg); color: var(--dark); align-self: flex-end; border-radius: 14px 14px 4px 14px; }
.mtime { font-size: .62em; opacity: .6; margin-top: 3px; }
.chatinputbar { display: flex; gap: 8px; padding-top: 10px; border-top: 1px solid var(--border); }
.chatinputbar input { flex: 1; padding: 9px 12px; border: 1.5px solid var(--border); border-radius: 50px; font-size: .88em; font-family: 'Tajawal', sans-serif; outline: none; background: var(--bg); }
.chatinputbar input:focus { background: #fff; border-color: var(--blue); }
.sendbtn { background: var(--blue); color: #fff; border: none; border-radius: 50%; width: 36px; height: 36px; font-size: .95em; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

/* ===== PLANS ===== */
.plans-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
.plan-card { border: 2px solid var(--border); border-radius: var(--radius); padding: 14px; text-align: center; cursor: pointer; transition: all .2s; }
.plan-card.on, .plan-card:hover { border-color: var(--gold); background: var(--gold-light); }
.plan-price { font-size: 1.3em; font-weight: 800; color: var(--orange); }
.plan-name { font-size: .88em; font-weight: 700; margin-bottom: 4px; }
.plan-desc { font-size: .73em; color: var(--gray); }

/* ===== TOAST ===== */
.toast { position: fixed; bottom: 82px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--dark); color: #fff; padding: 9px 20px; border-radius: 50px; font-size: .85em; font-weight: 600; z-index: 9999; opacity: 0; transition: all .3s; pointer-events: none; white-space: nowrap; }
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
.toast.ok { background: var(--green); }
.toast.bad { background: var(--red); }

/* ===== MISC ===== */
.slabel { font-size: .78em; font-weight: 800; color: var(--gray); margin: 14px 0 8px; display: block; }
hr.div { border: none; border-top: 1px solid var(--border); margin: 12px 0; }
#imgPrev img { width: 100%; border-radius: 10px; margin-top: 8px; }

/* ===== LOGIN PAGE (login.html) ===== */
.login-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; background: linear-gradient(135deg,var(--blue),#283593); }
.login-card { background: #fff; border-radius: 20px; padding: 28px 22px; width: 100%; max-width: 400px; box-shadow: 0 10px 40px rgba(0,0,0,.2); }

/* ===== ADMIN STANDALONE PAGE (admin.html) ===== */
.admin-page-wrap { max-width: 700px; margin: 0 auto; padding: 16px; }
.admin-lock { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 80vh; text-align: center; padding: 20px; color: var(--gray); }
.admin-lock i { font-size: 3em; margin-bottom: 14px; opacity: .4; }
