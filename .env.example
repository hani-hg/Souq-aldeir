# Public application URL used in the Firebase action link
APP_URL=https://your-domain.example
PORT=5000
CORS_ORIGIN=https://your-domain.example

# Outlook SMTP — enter the App Password, never commit it
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-outlook-address@outlook.com
SMTP_APP_PASSWORD=PUT_OUTLOOK_APP_PASSWORD_HERE
SMTP_FROM_NAME=سوق دير الزور

# Firebase Admin SDK — use either the JSON option or the three separate values
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Cloudinary signed uploads — never commit the API secret
CLOUDINARY_CLOUD_NAME=dzjy5tubx
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
