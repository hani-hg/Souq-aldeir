   الإصدار 2.0
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{

    --primary:#0D6EFD;
    --secondary:#198754;
    --danger:#DC3545;

    --background:#F5F7FA;

    --card:#FFFFFF;

    --text:#222;

    --border:#E5E5E5;

    --shadow:0 8px 25px rgba(0,0,0,.08);

    --radius:15px;

}

body{

    font-family:"Cairo",sans-serif;

    background:var(--background);

    color:var(--text);

    direction:rtl;

    padding-bottom:90px;

}

/* ================= Header ================= */

.header{

    background:white;

    position:sticky;

    top:0;

    z-index:999;

    padding:15px;

    box-shadow:0 2px 15px rgba(0,0,0,.08);

}

.logo{

    font-size:28px;

    font-weight:800;

    color:var(--primary);

    text-align:center;

    margin-bottom:15px;

}

.search{

    display:flex;

    gap:10px;

}

.search input{

    flex:1;

    height:50px;

    border:none;

    background:#f0f2f5;

    border-radius:12px;

    padding:15px;

    font-size:16px;

}

.search button{

    width:55px;

    border:none;

    border-radius:12px;

    background:var(--primary);

    color:white;

    cursor:pointer;

    font-size:20px;

}

/* ================= Categories ================= */

.categories{

    display:grid;

    grid-template-columns:repeat(4,1fr);

    gap:12px;

    padding:20px;

}

.categories button{

    background:white;

    border:none;

    border-radius:15px;

    padding:15px;

    cursor:pointer;

    font-weight:700;

    box-shadow:var(--shadow);

    transition:.3s;

}

.categories button:hover{

    background:var(--primary);

    color:white;

    transform:translateY(-3px);

}

/* ================= Sections ================= */

.featured,

.latest{

    padding:20px;

}

.featured h2,

.latest h2{

    margin-bottom:20px;

    font-size:24px;

}

#featuredAds,

#latestAds{

    display:grid;

    grid-template-columns:repeat(auto-fill,minmax(250px,1fr));

    gap:20px;

}

/* ================= Card ================= */

.card{

    background:white;

    border-radius:15px;

    overflow:hidden;

    box-shadow:var(--shadow);

}

.card img{

    width:100%;

    height:180px;

    object-fit:cover;

}

.cardBody{

    padding:15px;

}

.price{

    color:var(--secondary);

    font-size:22px;

    font-weight:bold;

    margin-top:10px;

}

/* ================= Floating Button ================= */

.floating{

    position:fixed;

    bottom:90px;

    left:20px;

    width:65px;

    height:65px;

    border:none;

    border-radius:50%;

    background:var(--secondary);

    color:white;

    font-size:32px;

    cursor:pointer;

    box-shadow:var(--shadow);

}

/* ================= Bottom Navigation ================= */

.bottomNav{

    position:fixed;

    bottom:0;

    width:100%;

    background:white;

    display:flex;

    justify-content:space-around;

    align-items:center;

    height:70px;

    box-shadow:0 -5px 15px rgba(0,0,0,.1);

}

.bottomNav a{

    color:#555;

    text-decoration:none;

    display:flex;

    flex-direction:column;

    align-items:center;

    font-size:14px;

    gap:4px;

}

.bottomNav a:hover{

    color:var(--primary);

}
