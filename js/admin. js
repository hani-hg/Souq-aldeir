// ===== js/admin.js — لوحة المدير =====
import { auth, db } from './firebase.js';
import { collection, getDocs, updateDoc, deleteDoc, doc, query, where, setDoc } from 'firebase/firestore';
import { toast, openM, closeM } from './app.js';
import { getIsAdmin, getCurrentUser } from './auth.js';
import { loadAds, allAds } from './ads.js';

// ===== التحقق من الإشعارات (طلبات التمييز) =====
export async function checkAdminBadge() {
  const snap = await getDocs(query(collection(db, 'featuredRequests'), where('status', '==', 'pending'))).catch(() => null);
  const badge = document.getElementById('adminBadge');
  if (snap && snap.size > 0) {
    badge.style.display = 'flex';
    badge.textContent = snap.size;
  } else {
    badge.style.display = 'none';
  }
}

// ===== فتح لوحة المدير =====
export async function openAdmin() {
  if (!getIsAdmin()) return;
  const body = document.getElementById('adminBody');
  if (!body) return;
  body.innerHTML = '<div class="loading-state"><i class="fa fa-spinner fa-spin"></i><p>جاري التحميل...</p></div>';
  openM('adminModal');

  const [reqSnap, usersSnap] = await Promise.all([
    getDocs(query(collection(db, 'featuredRequests'), where('status', '==', 'pending'))).catch(() => ({ docs: [] })),
    getDocs(collection(db, 'users')).catch(() => ({ size: 0 }))
  ]);

  const reqs = reqSnap.docs.map(d => ({ id: d.id, ...d.data() }));
  let newsVal = '';
  try {
    const ndoc = await getDoc(doc(db, 'settings', 'news'));
    if (ndoc.exists() && ndoc.data().items) newsVal = ndoc.data().items.join('\n');
  } catch (e) {}

  body.innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px">
      <div class="dcard" style="text-align:center"><div class="dstat">${allAds.length}</div><div style="font-size:.72em;color:var(--gray)">إجمالي الإعلانات</div></div>
      <div class="dcard" style="text-align:center"><div class="dstat">${usersSnap.size || 0}</div><div style="font-size:.72em;color:var(--gray)">المستخدمون</div></div>
    </div>
    <span class="slabel">⭐ طلبات التمييز (${reqs.length})</span>
    ${reqs.length ? reqs.map(r => `
      <div class="admin-req">
        <div style="flex:1">
          <div style="font-weight:700;font-size:.88em">${r.adTitle || 'إعلان'}</div>
          <div style="font-size:.75em;color:var(--gray)">${r.plan || ''} · ${r.userEmail || ''}</div>
        </div>
        <button class="btn btn-green btn-sm" onclick="window.approveReq('${r.id}','${r.adId}')">✓ قبول</button>
        <button class="btn btn-red btn-sm" onclick="window.rejectReq('${r.id}')">✕ رفض</button>
      </div>`).join('')
    : '<p style="font-size:.85em;color:var(--gray);padding:8px 0">لا توجد طلبات معلقة ✅</p>'}
    <span class="slabel">📋 آخر الإعلانات</span>
    ${allAds.slice(0, 15).map(ad => `
      <div class="myadrow">
        <div class="myadimg">${ad.imageUrl ? `<img src="${ad.imageUrl}">` : '<i class="fa fa-image"></i>'}</div>
        <div class="myadinfo">
          <div class="myadtitle">${ad.title || ''}</div>
          <div class="myadstatus">${ad.userEmail || ''}</div>
        </div>
        <div class="myadbtns">
          <button class="icobtn ed" title="${ad.featured ? 'إلغاء تمييز' : 'تمييز'}" onclick="window.adminToggleFeat('${ad.id}',${!!ad.featured})" style="font-size:.75em">${ad.featured ? '★' : '☆'}</button>
          <button class="icobtn dl" onclick="window.adminDel('${ad.id}')"><i class="fa fa-trash"></i></button>
        </div>
      </div>`).join('')}
    <span class="slabel">📰 الشريط الإخباري</span>
    <div class="fg"><label>النصوص (كل سطر نص مستقل)</label><textarea id="newsTA" rows="4" placeholder="نص 1&#10;نص 2&#10;نص 3">${newsVal}</textarea></div>
    <button class="btn btn-blue btn-sm" onclick="window.saveNews()"><i class="fa fa-save"></i> حفظ الأخبار</button>
  `;
}

// ===== الموافقة على طلب تمييز =====
export async function approveReq(reqId, adId) {
  await updateDoc(doc(db, 'ads', adId), { featured: true }).catch(() => {});
  await updateDoc(doc(db, 'featuredRequests', reqId), { status: 'approved' }).catch(() => {});
  toast('تم تمييز الإعلان ⭐', 'ok');
  checkAdminBadge();
  loadAds();
  openAdmin();
}

// ===== رفض طلب تمييز =====
export async function rejectReq(reqId) {
  await updateDoc(doc(db, 'featuredRequests', reqId), { status: 'rejected' }).catch(() => {});
  toast('تم رفض الطلب', 'ok');
  checkAdminBadge();
  openAdmin();
}

// ===== حذف إعلان بواسطة المدير =====
export async function adminDel(id) {
  if (!confirm('حذف هذا الإعلان؟')) return;
  await deleteDoc(doc(db, 'ads', id)).catch(() => {});
  closeM('detailModal');
  toast('تم الحذف', 'ok');
  loadAds();
  openAdmin();
}

// ===== تبديل حالة التمييز لإعلان =====
export async function adminToggleFeat(id, cur) {
  await updateDoc(doc(db, 'ads', id), { featured: !cur }).catch(() => {});
  toast(cur ? 'تم إلغاء التمييز' : 'تم التمييز ⭐', 'ok');
  loadAds();
  openAdmin();
}

// ===== حفظ الشريط الإخباري =====
export async function saveNews() {
  const lines = document.getElementById('newsTA').value.split('\n').map(s => s.trim()).filter(Boolean);
  await setDoc(doc(db, 'settings', 'news'), { items: lines }).catch(() => {});
  toast('تم حفظ الأخبار ✅', 'ok');
  loadNews();
}
