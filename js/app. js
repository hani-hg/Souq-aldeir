import {
  db,
  collection,
  addDoc,
  getDocs,
  query,
  orderBy,
  serverTimestamp
} from "./firebase.js";

const latestAds = document.getElementById("latestAds");
const featuredAds = document.getElementById("featuredAds");

// إنشاء بطاقة إعلان
function createCard(ad) {
  return `
    <div class="card">
      <img src="${ad.image}" alt="${ad.title}">
      <div class="cardBody">
        <h3>${ad.title}</h3>
        <p>${ad.category}</p>
        <p>${ad.city}</p>
        <div class="price">${ad.price} $</div>
      </div>
    </div>
  `;
}

// تحميل الإعلانات من Firestore
async function loadAds() {
  latestAds.innerHTML = "جاري التحميل...";
  featuredAds.innerHTML = "جاري التحميل...";

  const q = query(
    collection(db, "ads"),
    orderBy("createdAt", "desc")
  );

  const snapshot = await getDocs(q);

  latestAds.innerHTML = "";
  featuredAds.innerHTML = "";

  const ads = [];

  snapshot.forEach(doc => {
    ads.push({
      id: doc.id,
      ...doc.data()
    });
  });

  ads.forEach(ad => {
    latestAds.innerHTML += createCard(ad);
  });

  ads.slice(0, 3).forEach(ad => {
    featuredAds.innerHTML += createCard(ad);
  });
}

// إضافة أول إعلان تجريبي إلى قاعدة البيانات
async function addFirstAd() {

  const snapshot = await getDocs(collection(db, "ads"));

  // إذا كانت القاعدة فارغة فقط
  if (snapshot.empty) {

    await addDoc(collection(db, "ads"), {
      title: "هيونداي توسان 2020",
      price: 18500,
      category: "سيارات",
      city: "دير الزور",
