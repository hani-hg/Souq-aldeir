// ===== js/app.js — المنطق الرئيسي للتطبيق =====
import { auth, db } from './firebase.js';
import { toast, openM, closeM, setBnav, buildCats, loadAds, applyFilter, slideTo, loadSlider, startSlider, toggleFav, openFavs, openDetail, delAd, openEdit, doAddAd, doEditAd, openDash, setupAdmin, doLogout, onUserBtn } from './ads.js';
import { openMsgs, startChat, openChat, sendMsg, stopChat } from './chat.js';
import { openAdmin, approveReq, rejectReq, adminDel, adminToggleFeat, saveNews, checkAdminBadge } from './admin.js';
import { doLogin, doSignup, sendOTP, verifyOTP, switchTab, updateUserBtn, setupAuthListener } from './auth.js';

// ===== جعل الدوال عامة للاستخدام في onclick =====
window.doLogin = doLogin;
window.doSignup = doSignup;
window.sendOTP = sendOTP;
window.verifyOTP = verifyOTP;
window.switchTab = switchTab;
window.openM = openM;
window.closeM = closeM;
window.toast = toast;
window.setBnav = setBnav;
window.pickCat = (n) => { window.activeCat = n === 'الكل' ? null : n; buildCats(); applyFilter(); };
window.applyFilter = applyFilter;
window.slideTo = slideTo;
window.toggleFav = toggleFav;
window.openFavs = openFavs;
window.openDetail = openDetail;
window.doAddAd = doAddAd;
window.doEditAd = doEditAd;
window.delAd = delAd;
window.openEdit = openEdit;
window.openDash = openDash;
window.setupAdmin = setupAdmin;
window.doLogout = doLogout;
window.onUserBtn = onUserBtn;
window.openMsgs = openMsgs;
window.startChat = startChat;
window.openChat = openChat;
window.sendMsg = sendMsg;
window.stopChat = stopChat;
window.openFeatured = () => { openM('featModal'); fillFeatSel(); };
window.pickPlan = (el, plan) => { document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('on')); el.classList.add('on'); window.chosenPlan = plan; };
window.reqFeatured = reqFeatured;
window.openAdmin = openAdmin;
window.approveReq = approveReq;
window.rejectReq = rejectReq;
window.adminDel = adminDel;
window.adminToggleFeat = adminToggleFeat;
window.saveNews = saveNews;

// ===== تشغيل التطبيق =====
document.addEventListener('DOMContentLoaded', () => {
  // بناء الفئات
  buildCats();
  // تحميل الإعلانات
  loadAds();
  // مراقبة حالة المصادقة
  setupAuthListener();
  // رفع الصورة في نموذج الإضافة
  document.getElementById('adImg')?.addEventListener('change', function() {
    const f = this.files[0]; if (!f) return;
    const r = new FileReader();
    r.onload = e => document.getElementById('imgPrev').innerHTML = `<img src="${e.target.result}">`;
    r.readAsDataURL(f);
  });
  // زر الإضافة
  document.getElementById('fabBtn').onclick = function() {
    if (!window.CU) { openM('authModal'); toast('سجل دخولك أولاً', 'bad'); return; }
    document.getElementById('addErr').className = 'errmsg';
    openM('addModal');
  };
  // البحث والفرز
  document.getElementById('searchQ')?.addEventListener('input', applyFilter);
  document.getElementById('sortEl')?.addEventListener('change', applyFilter);
});